# DMGDesk — Variabili d'ambiente
# Copia questo file come .env e compila i valori

# ── Telegram Notifiche ────────────────────────────────────────────────────────
# Ottieni il token da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=

# Ottieni il chat_id aprendo: https://api.telegram.org/bot<TOKEN>/getUpdates
# dopo aver mandato un messaggio al bot
TELEGRAM_CHAT_ID=

# Secondi tra un check stato e il successivo (default: 30)
TELEGRAM_INTERVAL_SEC=30

# Secondi di log fermo prima di notifica "log non aggiornato" (default: 300 = 5 min)
TELEGRAM_STALE_ALERT_SEC=300

# ── Assistente AI ─────────────────────────────────────────────────────────────
# Chiave API Anthropic per l'assistente chat integrato in DMGDesk
# Ottieni da: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
