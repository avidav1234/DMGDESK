; ================================================================
; SAVE_TOA_V2.SPF — Genera TOOL_SYNC.TOA usando $P_TOOLNO
; 
; FUNZIONAMENTO:
; Per ogni utensile: T="NOME" M6 → $P_TOOLNO = T-number dell'utensile
; Poi legge tutti i parametri live con $TC_DP3[$P_TOOLNO,1] ecc.
; Questo bypassa il limite degli indici variabili su PowerLine.
; 
; VANTAGGI rispetto a SAVE_TOA.SPF:
; - Completamente dinamico: se aggiungi/rimuovi utensili basta
;   aggiornare la lista T="nome" M6 (o usare la versione loop)
; - Legge il nome reale dal CNC (non hardcodato)
; - Stessa sintassi che già usi nei programmi NC
; 
; PREREQUISITI:
; - Macchina in stato sicuro (G0, utensile fuori dal pezzo)
; - Tutti gli utensili nel magazzino (non smontati)
; ================================================================
DEF INT _TS_RET
DEF STRING[32] _TS_NAME

; Crea file TOA
_TS_RET = DELETEFILE("//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA")
WRITE(0,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","METRIC")

G0 G90 G40  ; Stato sicuro per cambio utensile

; --- T=2802 "RENISHAW" ---
T="RENISHAW" M6
G4 F1
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_TP1[" <<$P_TOOLNO<< "]=1" <<CHR(10)
     <<"$TC_TP2[" <<$P_TOOLNO<< "]=" <<CHR(34) <<"RENISHAW" <<CHR(34) <<CHR(10)
     <<"$TC_TP3[" <<$P_TOOLNO<< "]=1" <<CHR(10)
     <<"$TC_TP4[" <<$P_TOOLNO<< "]=1" <<CHR(10)
     <<"$TC_TP5[" <<$P_TOOLNO<< "]=1" <<CHR(10)
     <<"$TC_TP6[" <<$P_TOOLNO<< "]=1" <<CHR(10)
     <<"$TC_TP7[" <<$P_TOOLNO<< "]=1")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_TP8[" <<$P_TOOLNO<< "]=" <<$TC_TP8[$P_TOOLNO])
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_TP9[" <<$P_TOOLNO<< "]=0" <<CHR(10)
     <<"$TC_TP10[" <<$P_TOOLNO<< "]=0" <<CHR(10)
     <<"$TC_TP11[" <<$P_TOOLNO<< "]=0")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_DP1[" <<$P_TOOLNO<< ",1]=710")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_DP2[" <<$P_TOOLNO<< ",1]=0")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_DP3[" <<$P_TOOLNO<< ",1]=" <<$TC_DP3[$P_TOOLNO,1])
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_DP4[" <<$P_TOOLNO<< ",1]=0" <<CHR(10)
     <<"$TC_DP5[" <<$P_TOOLNO<< ",1]=0")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
