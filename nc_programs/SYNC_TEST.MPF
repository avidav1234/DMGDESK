; ================================================================
; SYNC_TEST.MPF — Test sync 1 utensile da posizione 1 magazzino
; Versione minima e diretta
; ================================================================
DEF INT _T

; Leggi T-number in posizione 1 del Regal_120
_T = $TC_MPP6[1,1]

; Posizione vuota = ignora
IF _T == 0
  MSG("Pos 1 vuota")
  M30
ENDIF

; Porta l'utensile nel mandrino tramite T-number
; Su 840D si può chiamare con numero diretto: T=_T M6
; Se non funziona con variabile, usare: SETM(_T)
T=_T M6
G4 F2

; Ora _TNUM e _TNAME sono aggiornati dai GUD
; Scrivi TOA (WRITE modo 0 = crea/sovrascrive)
WRITE(0,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","METRIC")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_TP1[" <<_TNUM<< "]=1")
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_TP2[" <<_TNUM<< "]=" <<CHR(34) <<_TNAME <<CHR(34))
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_DP3[" <<_TNUM<< ",1]=" <<$TC_DP3[_TNUM,1])
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_DP6[" <<_TNUM<< ",1]=" <<$TC_DP6[_TNUM,1])
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_MOP2[" <<_TNUM<< ",1]=" <<$TC_MOP2[_TNUM,1])
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","$TC_MOP11[" <<_TNUM<< ",1]=" <<$TC_MOP11[_TNUM,1])

MSG("Scritto: T=" <<_TNUM<< "  " <<_TNAME)
M0
M30
