; ================================================================
; SAVE_TOA_V3.SPF — Genera TOOL_SYNC.TOA usando GUD _TNUM/_TNAME
; 
; MIGLIORAMENTO rispetto a V2:
; - Usa _TNUM (GUD) invece di $P_TOOLNO — più affidabile
; - Usa _TNAME (GUD) per scrivere il nome utensile live
; - Il nome nel TOA è sempre quello reale dalla NCU
; - Aggiunge _DM_DUPLO per rilevare automaticamente i dupli
; 
; DINAMICO: quando aggiungi un utensile, aggiungi solo
; la riga  T="NUOVO" M6  in questa lista.
; Tool Manager può rigenerare questo file automaticamente.
; ================================================================
DEF INT _TS_RET
DEF INT _TS_D

_TS_RET = DELETEFILE("//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA")
WRITE(0,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA","METRIC")

G0 G90 G40

; --- "RENISHAW" ---
T="RENISHAW" M6
G4 F1
; Dopo M6: _TNUM=T-number, _TNAME=nome confermato dalla NCU
WRITE(1,"//NC/WKS.DIR/_TOOLSYNC.WPD/TOOL_SYNC.TOA",
     "$TC_TP1[" <<_TNUM<< "]=1" <<CHR(10)
     <<"$TC_TP2[" <<_TNUM<< "]=" <<CHR(34) <<_TNAME <<CHR(34) <<CHR(10)
