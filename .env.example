# DMGDesk — Variabili d'ambiente
# Copia questo file come .env e compila i valori

# ── Telegram Notifiche ────────────────────────────────────────────────────────
# Ottieni il token da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=

# Ottieni il chat_id aprendo: https://api.telegram.org/bot<TOKEN>/getUpdates
# dopo aver mandato un messaggio al bot
TELEGRAM_CHAT_ID=

# Secondi tra un check stato e il successivo (default: 30)
TELEGRAM_INTERVAL_SEC=30

# Secondi di log fermo prima di notifica "log non aggiornato" (default: 300 = 5 min)
TELEGRAM_STALE_ALERT_SEC=300

# ── Sicurezza CORS ─────────────────────────────────────────────────────────────
# Backend e frontend girano same-origin sulla porta 8000, quindi in produzione
# normale CORS non serve. Settare solo se il frontend e' su un altro host.
# Lista origini autorizzate, separate da virgola. Se vuoto -> solo localhost.
# Esempio: DMG_CORS_ORIGINS=http://10.95.20.10:8000,http://dmgdesk-srv:8000
DMG_CORS_ORIGINS=

# ── Autenticazione ─────────────────────────────────────────────────────────────
# DUE meccanismi complementari (vedi api/auth.py). MODELLO SICURO consigliato:
#   - OPERATORI (umani): login col PIN → attivare DMG_AUTH_ENABLED=1. Il browser
#     ottiene un token di sessione a runtime; NESSUN segreto entra nel bundle.
#   - SERVIZI (cam_tracker, self-call): usano DMG_API_KEY (header X-API-Key).
# Attivarli INSIEME: solo DMG_API_KEY romperebbe la UI browser; solo l'auth PIN
# romperebbe l'upload del cam_tracker (che usa la stessa chiave).
#
# ⚠️ NON impostare VITE_API_KEY nel bundle frontend: metterebbe la master key
# dentro il JavaScript scaricabile da chiunque. Gli umani entrano col PIN.

# Attiva il login operatori (PIN + PBKDF2 + lockout). Vuoto/≠1 = nessun login (DEV).
# PRIMA di attivarlo, pre-imposta i PIN: `py scripts/reset_pin.py op1 --pin <cifre>`
# (altrimenti il primo che accede sceglie il PIN degli account op1/op2).
DMG_AUTH_ENABLED=
# Durata sessione operatore in ore (default 12).
DMG_AUTH_SESSION_ORE=12

# Master key per i servizi non interattivi (cam_tracker) e per il reset PIN admin.
# Se VUOTA e DMG_AUTH_ENABLED≠1 -> middleware disattivo (accesso libero, DEV).
# La STESSA chiave va messa anche nel cam_tracker: env DMG_API_KEY sulla macchina
# dell'estrattore, oppure [dmgdesk] api_key=<chiave> in cam_tracker_config.ini.
# Genera una chiave robusta: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
DMG_API_KEY=

# ── Schermo live macchina (relay VNC → noVNC) ──────────────────────────────────
# Proietta lo schermo reale del controllo (SINUMERIK 840D / PCU 50) dentro DMG
# Desk. Il relay si autentica al server VNC del PCU con questa password (che così
# NON arriva mai al browser). Vedi REPORT_DMG_DESK_SCHERMO_LIVE.md.
#   - DMG_VNC_PASSWORD: password del server VNC del PCU. Va messa SOLO nel `.env`
#     locale del backend, MAI in questo file di esempio (che è committato in git).
#     ⚠️ Sul campo è risultata il default di fabbrica Siemens: da CAMBIARE a bordo
#     macchina (insieme alla config dei TCU) appena possibile.
#   - DMG_VNC_HOST/PORT: opzionali, default 10.95.20.29:5900.
DMG_VNC_PASSWORD=
# DMG_VNC_HOST=10.95.20.29
# DMG_VNC_PORT=5900
