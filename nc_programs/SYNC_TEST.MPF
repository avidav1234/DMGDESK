; ================================================================
; SYNC_TEST.MPF — Test scrittura con path formato NCK interno
; ================================================================
DEF INT _T

_T = $TC_MPP6[1,1]

IF _T == 0
  MSG("Posizione 1 vuota")
  M30
ENDIF

; Path formato NCK interno — stesso stile del MAIN che funziona
; _TOOLSYNC.WPD -> _N__TOOLSYNC_WPD
; TOOL_SYNC.TOA -> _N_TOOL_SYNC_TOA
WRITE(0,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","METRIC")
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_TP1[" <<_T<< "]=1")
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_TP2[" <<_T<< "]=" <<$TC_TP2[_T])
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_TP8[" <<_T<< "]=" <<$TC_TP8[_T])
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_DP3[" <<_T<< ",1]=" <<$TC_DP3[_T,1])
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_DP6[" <<_T<< ",1]=" <<$TC_DP6[_T,1])
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_MOP2[" <<_T<< ",1]=" <<$TC_MOP2[_T,1])
WRITE(1,"/_N_WKS_DIR/_N__TOOLSYNC_WPD/_N_TOOL_SYNC_TOA","$TC_MOP11[" <<_T<< ",1]=" <<$TC_MOP11[_T,1])

MSG("Scritto T=" <<_T<< " nome=" <<$TC_TP2[_T])
M0
M30
