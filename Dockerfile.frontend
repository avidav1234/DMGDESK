# ── Frontend React — Tool Manager V14 ───────────────────────
# Stage 1: build
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package.json .
RUN npm install

COPY frontend/ .

# VITE_API_URL vuoto = usa il proxy nginx (/api → backend)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: serve con nginx
FROM nginx:alpine

# Copia build
COPY --from=builder /app/dist /usr/share/nginx/html

# Configurazione nginx: proxy /api → backend, serve React per tutto il resto
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
