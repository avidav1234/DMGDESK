# ── Backend FastAPI — Tool Manager V14 ──────────────────────
FROM python:3.12-slim

WORKDIR /app

# Installa dipendenze Python
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn[standard] pandas numpy python-multipart

# Copia codice sorgente (escludi UI desktop e test)
COPY config/    ./config/
COPY database/  ./database/
COPY logic/     ./logic/
COPY utils/     ./utils/
COPY api/       ./api/

# Cartella dati (montata come volume in docker-compose)
RUN mkdir -p /data /app/logs

# Porta esposta
EXPOSE 8000

# Avvio — senza --reload in produzione
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
