; ================================================================
; TEST_LOOP.MPF — Testa se $TC_TP1[_T] funziona con indice variabile
; Eseguire in MDI o come programma
; Se NON da allarme 17020: approccio dinamico è possibile
; Se DA allarme 17020: usare approccio con GUD o Salva Attrezzaggio
; ================================================================
DEF INT _T
DEF INT _COUNT
_T = 2800
_COUNT = 0

; Tenta di leggere TC_TP1 con indice variabile su 3 utensili noti
IF $TC_TP1[_T] == 1
  _COUNT = _COUNT + 1
ENDIF
_T = _T + 1
IF $TC_TP1[_T] == 1
  _COUNT = _COUNT + 1
ENDIF
_T = _T + 1
IF $TC_TP1[_T] == 1
  _COUNT = _COUNT + 1
ENDIF

; Se arriva qui senza allarme: loop funziona
; _COUNT dovrebbe essere 1 (solo T=2802 esiste nel range 2800-2802)
MSG("TEST OK: trovati " <<_COUNT<< " utensili - loop TC_TP1 funziona!")
M0  ; Pausa per leggere il messaggio
M30
